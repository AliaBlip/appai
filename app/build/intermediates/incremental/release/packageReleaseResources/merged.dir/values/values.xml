    <style name="TextAppearance.HyAI.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:lineSpacingExtra">6dp</item>
    </style>
    <style name="TextAppearance.HyAI.Headline" parent="TextAppearance.Material3.HeadlineMedium">
