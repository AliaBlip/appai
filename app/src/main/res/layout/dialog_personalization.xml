<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#FF1A1A2E">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">

        <!-- Header -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal" android:layout_marginBottom="20dp">
            <ImageView android:layout_width="26dp" android:layout_height="26dp"
                android:contentDescription="Settings" android:src="@drawable/ic_settings" app:tint="@color/accent_purple" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="10dp" android:text="@string/personalization" android:textColor="#FFFFFF"
                android:textSize="20sp" android:textStyle="bold" />
        </LinearLayout>

        <!-- Profile -->
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginBottom="10dp"
            app:cardBackgroundColor="#FF1E1E3E" app:cardCornerRadius="14dp" app:cardElevation="0dp"
            app:contentPadding="14dp" app:strokeColor="#FF3A3A5E" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center_vertical" android:orientation="horizontal" android:layout_marginBottom="10dp">
                    <ImageView android:layout_width="20dp" android:layout_height="20dp"
                        android:contentDescription="Person" android:src="@drawable/ic_person" app:tint="@color/accent_purple" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginStart="8dp" android:text="@string/display_name" android:textColor="#FFFFFF"
                        android:textSize="15sp" android:textStyle="bold" />
                </LinearLayout>
                <EditText android:id="@+id/et_display_name" android:layout_width="match_parent" android:layout_height="44dp"
                    android:background="@drawable/bg_input_field" android:hint="@string/display_name_hint"
                    android:imeOptions="actionDone" android:inputType="textPersonName" android:paddingHorizontal="14dp"
                    android:textColor="#FFFFFF" android:textColorHint="#FF6E6E6E" android:textSize="14sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- App Theme -->
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginBottom="10dp"
            app:cardBackgroundColor="#FF1E1E3E" app:cardCornerRadius="14dp" app:cardElevation="0dp"
            app:contentPadding="14dp" app:strokeColor="#FF3A3A5E" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center_vertical" android:orientation="horizontal" android:layout_marginBottom="8dp">
                    <ImageView android:layout_width="20dp" android:layout_height="20dp"
                        android:contentDescription="Theme" android:src="@drawable/ic_paint" app:tint="@color/accent_purple" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginStart="8dp" android:text="@string/app_theme" android:textColor="#FFFFFF"
                        android:textSize="15sp" android:textStyle="bold" />
                </LinearLayout>
                <RadioGroup android:id="@+id/rg_theme" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <RadioButton android:id="@+id/theme_default" android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:buttonTint="@color/accent_purple" android:text="@string/theme_default"
                        android:textColor="#FFFFFF" android:textSize="12sp" android:checked="true" />
                    <RadioButton android:id="@+id/theme_whatsapp" android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:buttonTint="#FF00A884" android:text="@string/theme_whatsapp"
                        android:textColor="#FFFFFF" android:textSize="12sp" />
                    <RadioButton android:id="@+id/theme_telegram" android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:buttonTint="#FF8774E1" android:text="@string/theme_telegram"
                        android:textColor="#FFFFFF" android:textSize="12sp" />
                </RadioGroup>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Accent Color -->
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginBottom="10dp"
            app:cardBackgroundColor="#FF1E1E3E" app:cardCornerRadius="14dp" app:cardElevation="0dp"
            app:contentPadding="14dp" app:strokeColor="#FF3A3A5E" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center_vertical" android:orientation="horizontal" android:layout_marginBottom="8dp">
                    <ImageView android:layout_width="20dp" android:layout_height="20dp"
                        android:contentDescription="Color" android:src="@drawable/ic_palette" app:tint="@color/accent_purple" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginStart="8dp" android:text="@string/accent_color" android:textColor="#FFFFFF"
                        android:textSize="15sp" android:textStyle="bold" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center" android:orientation="horizontal">
                    <ImageView android:id="@+id/color_purple" android:layout_width="0dp" android:layout_height="40dp"
                        android:layout_margin="2dp" android:layout_weight="1" android:background="@drawable/bg_icon_circle"
                        android:backgroundTint="@color/swatch_purple" android:contentDescription="Purple"
                        android:padding="8dp" android:src="@drawable/ic_check" app:tint="#FFFFFF" />
                    <ImageView android:id="@+id/color_blue" android:layout_width="0dp" android:layout_height="40dp"
                        android:layout_margin="2dp" android:layout_weight="1" android:background="@drawable/bg_icon_circle"
                        android:backgroundTint="@color/swatch_blue" android:contentDescription="Blue" android:padding="8dp"
                        android:src="@drawable/ic_check" app:tint="#FFFFFF" />
                    <ImageView android:id="@+id/color_green" android:layout_width="0dp" android:layout_height="40dp"
                        android:layout_margin="2dp" android:layout_weight="1" android:background="@drawable/bg_icon_circle"
                        android:backgroundTint="@color/swatch_green" android:contentDescription="Green" android:padding="8dp"
                        android:src="@drawable/ic_check" app:tint="#FFFFFF" />
                    <ImageView android:id="@+id/color_pink" android:layout_width="0dp" android:layout_height="40dp"
                        android:layout_margin="2dp" android:layout_weight="1" android:background="@drawable/bg_icon_circle"
                        android:backgroundTint="@color/swatch_pink" android:contentDescription="Pink" android:padding="8dp"
                        android:src="@drawable/ic_check" app:tint="#FFFFFF" />
                    <ImageView android:id="@+id/color_orange" android:layout_width="0dp" android:layout_height="40dp"
                        android:layout_margin="2dp" android:layout_weight="1" android:background="@drawable/bg_icon_circle"
                        android:backgroundTint="@color/swatch_orange" android:contentDescription="Orange" android:padding="8dp"
                        android:src="@drawable/ic_check" app:tint="#FFFFFF" />
                    <ImageView android:id="@+id/color_cyan" android:layout_width="0dp" android:layout_height="40dp"
                        android:layout_margin="2dp" android:layout_weight="1" android:background="@drawable/bg_icon_circle"
                        android:backgroundTint="@color/swatch_cyan" android:contentDescription="Cyan" android:padding="8dp"
                        android:src="@drawable/ic_check" app:tint="#FFFFFF" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Font Size -->
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginBottom="10dp"
            app:cardBackgroundColor="#FF1E1E3E" app:cardCornerRadius="14dp" app:cardElevation="0dp"
            app:contentPadding="14dp" app:strokeColor="#FF3A3A5E" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center_vertical" android:orientation="horizontal" android:layout_marginBottom="8dp">
                    <ImageView android:layout_width="20dp" android:layout_height="20dp"
                        android:contentDescription="Font" android:src="@drawable/ic_text_size" app:tint="@color/accent_purple" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginStart="8dp" android:text="@string/font_size" android:textColor="#FFFFFF"
                        android:textSize="15sp" android:textStyle="bold" />
                </LinearLayout>
                <RadioGroup android:id="@+id/rg_font_size" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <RadioButton android:id="@+id/font_small" android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:buttonTint="@color/accent_purple" android:text="@string/font_small"
                        android:textColor="#FFFFFF" android:textSize="13sp" />
                    <RadioButton android:id="@+id/font_medium" android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:buttonTint="@color/accent_purple" android:checked="true"
                        android:text="@string/font_medium" android:textColor="#FFFFFF" android:textSize="13sp" />
                    <RadioButton android:id="@+id/font_large" android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:buttonTint="@color/accent_purple" android:text="@string/font_large"
                        android:textColor="#FFFFFF" android:textSize="13sp" />
                </RadioGroup>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Bubble Style -->
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginBottom="10dp"
            app:cardBackgroundColor="#FF1E1E3E" app:cardCornerRadius="14dp" app:cardElevation="0dp"
            app:contentPadding="14dp" app:strokeColor="#FF3A3A5E" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center_vertical" android:orientation="horizontal" android:layout_marginBottom="8dp">
                    <ImageView android:layout_width="20dp" android:layout_height="20dp"
                        android:contentDescription="Bubble" android:src="@drawable/ic_robot" app:tint="@color/accent_purple" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginStart="8dp" android:text="@string/bubble_style" android:textColor="#FFFFFF"
                        android:textSize="15sp" android:textStyle="bold" />
                </LinearLayout>
                <RadioGroup android:id="@+id/rg_bubble_options" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical">
                    <RadioButton android:id="@+id/bubble_rounded" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:buttonTint="@color/accent_purple"
                        android:text="@string/bubble_rounded" android:textColor="#FFFFFF" android:textSize="13sp" />
                    <RadioButton android:id="@+id/bubble_classic" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:buttonTint="@color/accent_purple"
                        android:text="@string/bubble_classic" android:textColor="#FFFFFF" android:textSize="13sp" />
                    <RadioButton android:id="@+id/bubble_whatsapp" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:buttonTint="#FF00A884"
                        android:text="@string/bubble_whatsapp" android:textColor="#FFFFFF" android:textSize="13sp" />
                    <RadioButton android:id="@+id/bubble_telegram" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:buttonTint="#FF8774E1"
                        android:text="@string/bubble_telegram" android:textColor="#FFFFFF" android:textSize="13sp" />
                </RadioGroup>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Toggles -->
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginBottom="10dp"
            app:cardBackgroundColor="#FF1E1E3E" app:cardCornerRadius="14dp" app:cardElevation="0dp"
            app:contentPadding="14dp" app:strokeColor="#FF3A3A5E" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center_vertical" android:orientation="horizontal" android:layout_marginBottom="8dp">
                    <ImageView android:layout_width="20dp" android:layout_height="20dp"
                        android:contentDescription="AI" android:src="@drawable/ic_robot" app:tint="@color/accent_purple" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginStart="8dp" android:text="AI Behavior" android:textColor="#FFFFFF"
                        android:textSize="15sp" android:textStyle="bold" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center_vertical" android:orientation="horizontal" android:layout_marginBottom="10dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Auto-switch model" android:textColor="#FFFFFF" android:textSize="14sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Smart model selection" android:textColor="#FF9E9E9E" android:textSize="11sp" />
                    </LinearLayout>
                    <Switch android:id="@+id/switch_auto_model" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:checked="true" android:thumbTint="@color/accent_purple"
                        app:trackTint="@color/purple_700" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#FF3A3A5E" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center_vertical" android:orientation="horizontal" android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Unfiltered Mode" android:textColor="#FFFFFF" android:textSize="14sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="No restrictions" android:textColor="#FF9E9E9E" android:textSize="11sp" />
                    </LinearLayout>
                    <Switch android:id="@+id/switch_unfiltered" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:checked="true" android:thumbTint="@color/accent_purple"
                        app:trackTint="@color/purple_700" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#FF3A3A5E" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center_vertical" android:orientation="horizontal" android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/theme_amoled" android:textColor="#FFFFFF" android:textSize="14sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Pure black background" android:textColor="#FF9E9E9E" android:textSize="11sp" />
                    </LinearLayout>
                    <Switch android:id="@+id/switch_amoled" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:checked="false" android:thumbTint="@color/accent_purple"
                        app:trackTint="@color/purple_700" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#FF3A3A5E" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center_vertical" android:orientation="horizontal" android:layout_marginTop="10dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/web_search" android:textColor="#FFFFFF" android:textSize="14sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/web_search_desc" android:textColor="#FF9E9E9E" android:textSize="11sp" />
                    </LinearLayout>
                    <Switch android:id="@+id/switch_web_search" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:checked="false" android:thumbTint="@color/accent_purple"
                        app:trackTint="@color/purple_700" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Custom Instructions -->
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginBottom="10dp"
            app:cardBackgroundColor="#FF1E1E3E" app:cardCornerRadius="14dp" app:cardElevation="0dp"
            app:contentPadding="14dp" app:strokeColor="#FF3A3A5E" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center_vertical" android:orientation="horizontal" android:layout_marginBottom="8dp">
                    <ImageView android:layout_width="20dp" android:layout_height="20dp"
                        android:contentDescription="Instructions" android:src="@drawable/ic_idea"
                        app:tint="@color/accent_purple" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginStart="8dp" android:text="@string/custom_instructions"
                        android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" />
                </LinearLayout>
                <EditText android:id="@+id/et_custom_instructions" android:layout_width="match_parent"
                    android:layout_height="60dp" android:background="@drawable/bg_input_field" android:gravity="top"
                    android:hint="@string/custom_instructions_hint" android:imeOptions="actionDone"
                    android:inputType="textMultiLine" android:padding="12dp" android:textColor="#FFFFFF"
                    android:textColorHint="#FF6E6E6E" android:textSize="13sp" android:lines="3" android:maxLines="5" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- API Key -->
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginBottom="10dp"
            app:cardBackgroundColor="#FF1E1E3E" app:cardCornerRadius="14dp" app:cardElevation="0dp"
            app:contentPadding="14dp" app:strokeColor="#FF3A3A5E" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center_vertical" android:orientation="horizontal" android:layout_marginBottom="8dp">
                    <ImageView android:layout_width="20dp" android:layout_height="20dp"
                        android:contentDescription="Key" android:src="@drawable/ic_model_gpt"
                        app:tint="@color/accent_purple" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginStart="8dp" android:text="@string/api_key" android:textColor="#FFFFFF"
                        android:textSize="15sp" android:textStyle="bold" />
                </LinearLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/api_key_desc" android:textColor="#FF9E9E9E"
                    android:textSize="11sp" android:layout_marginBottom="8dp" />
                <EditText android:id="@+id/et_api_key" android:layout_width="match_parent" android:layout_height="44dp"
                    android:background="@drawable/bg_input_field" android:hint="@string/api_key_placeholder"
                    android:imeOptions="actionDone" android:inputType="textVisiblePassword"
                    android:paddingHorizontal="14dp" android:textColor="#FFFFFF" android:textColorHint="#FF6E6E6E"
                    android:textSize="13sp" android:singleLine="true" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center_vertical" android:orientation="horizontal" android:layout_marginTop="8dp">
                    <TextView android:id="@+id/tv_api_status" android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="@string/api_key_default_used"
                        android:textColor="#FF9E9E9E" android:textSize="11sp" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btn_test_api"
                        android:layout_width="wrap_content" android:layout_height="36dp" android:text="@string/test_api"
                        android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="11sp"
                        app:backgroundTint="@color/accent_purple" app:cornerRadius="18dp" />
                </LinearLayout>
                <LinearLayout android:id="@+id/layout_api_how" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="10dp"
                    android:padding="12dp" android:background="#FF12122E" android:visibility="gone">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/api_key_how_title" android:textColor="#FF6C63FF" android:textSize="13sp"
                        android:textStyle="bold" android:layout_marginBottom="6dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/api_key_how_text" android:textColor="#FFC0C0C0"
                        android:textSize="11sp" android:lineSpacingExtra="3dp" />
                </LinearLayout>
                <TextView android:id="@+id/btn_toggle_api_how" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="How to get an API key?"
                    android:textColor="#FF6C63FF" android:textSize="11sp" android:layout_marginTop="6dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- About -->
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginBottom="12dp"
            app:cardBackgroundColor="#FF1E1E3E" app:cardCornerRadius="14dp" app:cardElevation="0dp"
            app:contentPadding="14dp" app:strokeColor="#FF3A3A5E" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center" android:orientation="vertical">
                <ImageView android:layout_width="36dp" android:layout_height="36dp" android:contentDescription="HyAI"
                    android:src="@drawable/ic_hyai_logo" app:tint="@color/accent_purple" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp"
                    android:text="@string/about_hyai" android:textColor="#FFFFFF" android:textSize="16sp"
                    android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/created_by" android:textColor="@color/accent_purple" android:textSize="13sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/powered_by" android:textColor="#FF9E9E9E" android:textSize="11sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" android:text="v2.1.0" android:textColor="#FF6E6E6E" android:textSize="10sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton android:id="@+id/btn_save_settings"
            android:layout_width="match_parent" android:layout_height="48dp" android:text="@string/saved"
            android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold"
            app:backgroundTint="@color/accent_purple" app:cornerRadius="24dp" />
