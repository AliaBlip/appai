            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="#FF2A2A4E"
                android:contentDescription="DeepSeek"
                android:padding="8dp"
                android:src="@drawable/ic_model_deepseek"
                app:tint="@color/model_deepseek_color" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/model_deepseek"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Technical \u00B7 Coding &amp; math"
                    android:textColor="#FF9E9E9E"
                    android:textSize="12sp" />
            </LinearLayout>

            <RadioButton
                android:id="@+id/radio_deepseek"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/model_deepseek_color" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
