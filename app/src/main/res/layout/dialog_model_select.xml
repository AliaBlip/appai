                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_icon_circle"
                android:gravity="center">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:contentDescription="Smart"
                    android:src="@drawable/ic_model_claude"
                    app:tint="@color/model_claude_color" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/model_claude"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Deep thinking \u00B7 Creative &amp; detailed"
                    android:textColor="#FF9E9E9E"
                    android:textSize="12sp" />
            </LinearLayout>

            <RadioButton
                android:id="@+id/radio_claude"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/model_claude_color" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- HyAI Vision -->
    <com.google.android.material.card.MaterialCardView
