<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FF1A1A2E"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:text="@string/select_model"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="Choose which AI model to power your conversation"
        android:textColor="#FF9E9E9E"
        android:textSize="13sp" />

    <!-- HyAI Basic -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/model_gpt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        app:cardBackgroundColor="#FF1E1E3E"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:contentPadding="14dp"
        app:strokeColor="#FF3A3A5E"
        app:strokeWidth="1dp"
        android:foreground="?attr/selectableItemBackground">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_icon_circle"
                android:gravity="center">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:contentDescription="Basic"
                    android:src="@drawable/ic_model_gpt"
                    app:tint="@color/model_gpt_color" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/model_gpt"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="General purpose \u00B7 Fast &amp; reliable"
                    android:textColor="#FF9E9E9E"
                    android:textSize="12sp" />
            </LinearLayout>

            <RadioButton
                android:id="@+id/radio_gpt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/model_gpt_color" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- HyAI Smart -->
    <com.google.android.material.card.MaterialCardView
