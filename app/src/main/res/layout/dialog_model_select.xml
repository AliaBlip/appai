<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:background="#FF1A1A2E" android:orientation="vertical" android:padding="16dp">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginBottom="4dp" android:text="@string/select_model"
        android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold" />

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginBottom="14dp" android:text="Choose your AI mode"
        android:textColor="#FF9E9E9E" android:textSize="13sp" />

    <!-- HyAI Basic -->
    <com.google.android.material.card.MaterialCardView android:id="@+id/model_gpt"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginBottom="8dp" app:cardBackgroundColor="#FF1E1E3E"
        app:cardCornerRadius="14dp" app:cardElevation="0dp" app:contentPadding="12dp"
        app:strokeColor="#FF3A3A5E" app:strokeWidth="1dp"
        android:foreground="?attr/selectableItemBackground">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal">
            <LinearLayout android:layout_width="48dp" android:layout_height="48dp"
                android:background="@drawable/bg_icon_circle" android:gravity="center">
                <ImageView android:layout_width="28dp" android:layout_height="28dp"
                    android:contentDescription="Basic" android:src="@drawable/ic_model_gpt"
                    app:tint="@color/model_gpt_color" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/model_gpt" android:textColor="#FFFFFF"
                    android:textSize="16sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="General purpose" android:textColor="#FF9E9E9E" android:textSize="12sp" />
            </LinearLayout>
            <RadioButton android:id="@+id/radio_gpt" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:buttonTint="@color/model_gpt_color" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- HyAI Smart -->
    <com.google.android.material.card.MaterialCardView android:id="@+id/model_claude"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginBottom="8dp" app:cardBackgroundColor="#FF1E1E3E"
        app:cardCornerRadius="14dp" app:cardElevation="0dp" app:contentPadding="12dp"
        app:strokeColor="#FF3A3A5E" app:strokeWidth="1dp"
        android:foreground="?attr/selectableItemBackground">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal">
            <LinearLayout android:layout_width="48dp" android:layout_height="48dp"
                android:background="@drawable/bg_icon_circle" android:gravity="center">
                <ImageView android:layout_width="28dp" android:layout_height="28dp"
                    android:contentDescription="Smart" android:src="@drawable/ic_model_claude"
                    app:tint="@color/model_claude_color" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/model_claude" android:textColor="#FFFFFF"
                    android:textSize="16sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Deep thinking" android:textColor="#FF9E9E9E" android:textSize="12sp" />
            </LinearLayout>
            <RadioButton android:id="@+id/radio_claude" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:buttonTint="@color/model_claude_color" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- HyAI Vision -->
    <com.google.android.material.card.MaterialCardView android:id="@+id/model_gemini"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginBottom="8dp" app:cardBackgroundColor="#FF1E1E3E"
        app:cardCornerRadius="14dp" app:cardElevation="0dp" app:contentPadding="12dp"
        app:strokeColor="#FF3A3A5E" app:strokeWidth="1dp"
        android:foreground="?attr/selectableItemBackground">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal">
            <LinearLayout android:layout_width="48dp" android:layout_height="48dp"
                android:background="@drawable/bg_icon_circle" android:gravity="center">
                <ImageView android:layout_width="28dp" android:layout_height="28dp"
                    android:contentDescription="Vision" android:src="@drawable/ic_model_gemini"
                    app:tint="@color/model_gemini_color" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/model_gemini" android:textColor="#FFFFFF"
                    android:textSize="16sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Multimodal &amp; visual" android:textColor="#FF9E9E9E" android:textSize="12sp" />
            </LinearLayout>
            <RadioButton android:id="@+id/radio_gemini" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:buttonTint="@color/model_gemini_color" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- HyAI Speed -->
    <com.google.android.material.card.MaterialCardView android:id="@+id/model_grok"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginBottom="8dp" app:cardBackgroundColor="#FF1E1E3E"
        app:cardCornerRadius="14dp" app:cardElevation="0dp" app:contentPadding="12dp"
        app:strokeColor="#FF3A3A5E" app:strokeWidth="1dp"
        android:foreground="?attr/selectableItemBackground">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal">
            <LinearLayout android:layout_width="48dp" android:layout_height="48dp"
                android:background="@drawable/bg_icon_circle" android:gravity="center">
                <ImageView android:layout_width="28dp" android:layout_height="28dp"
                    android:contentDescription="Speed" android:src="@drawable/ic_model_grok"
                    app:tint="@color/model_grok_color" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/model_grok" android:textColor="#FFFFFF"
                    android:textSize="16sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Real-time fast" android:textColor="#FF9E9E9E" android:textSize="12sp" />
            </LinearLayout>
            <RadioButton android:id="@+id/radio_grok" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:buttonTint="@color/model_grok_color" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- HyAI Code -->
    <com.google.android.material.card.MaterialCardView android:id="@+id/model_deepseek"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginBottom="16dp" app:cardBackgroundColor="#FF1E1E3E"
        app:cardCornerRadius="14dp" app:cardElevation="0dp" app:contentPadding="12dp"
        app:strokeColor="#FF3A3A5E" app:strokeWidth="1dp"
        android:foreground="?attr/selectableItemBackground">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal">
            <LinearLayout android:layout_width="48dp" android:layout_height="48dp"
                android:background="@drawable/bg_icon_circle" android:gravity="center">
                <ImageView android:layout_width="28dp" android:layout_height="28dp"
                    android:contentDescription="Code" android:src="@drawable/ic_model_deepseek"
                    app:tint="@color/model_deepseek_color" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/model_deepseek" android:textColor="#FFFFFF"
                    android:textSize="16sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Coding &amp; technical" android:textColor="#FF9E9E9E" android:textSize="12sp" />
            </LinearLayout>
            <RadioButton android:id="@+id/radio_deepseek" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:buttonTint="@color/model_deepseek_color" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
