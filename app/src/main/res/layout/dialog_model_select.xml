                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/model_gemini"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Multimodal \u00B7 Visual &amp; reasoning"
                    android:textColor="#FF9E9E9E"
                    android:textSize="12sp" />
            </LinearLayout>

            <RadioButton
                android:id="@+id/radio_gemini"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/model_gemini_color" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- HyAI Speed -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/model_grok"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        app:cardBackgroundColor="#FF1E1E3E"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:contentPadding="14dp"
        app:strokeColor="#FF3A3A5E"
