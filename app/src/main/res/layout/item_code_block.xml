<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="3dp"
    android:paddingBottom="3dp"
    android:paddingLeft="4dp"
    android:paddingRight="4dp">

    <!-- Header -->
    <LinearLayout android:id="@+id/layout_header"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal"
        android:paddingBottom="3dp">

        <ImageView android:id="@+id/iv_avatar" android:layout_width="22dp"
            android:layout_height="22dp" android:contentDescription="Avatar" />

        <TextView android:id="@+id/tv_sender" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginStart="6dp"
            android:textSize="11sp" android:textStyle="bold" />

        <TextView android:id="@+id/tv_timestamp" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginStart="6dp"
            android:textSize="9sp" />
    </LinearLayout>

    <!-- Code Block Card -->
    <LinearLayout
        android:id="@+id/layout_bubble"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="start"
        android:orientation="vertical"
        android:padding="3dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            app:cardBackgroundColor="#FF1A1A2E"
            app:cardCornerRadius="10dp"
            app:cardElevation="2dp"
            app:strokeColor="#FF3A3A5E"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Code Header Bar -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:background="#FF12122E"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="10dp">

                    <TextView
                        android:id="@+id/tv_code_lang"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Code"
                        android:textColor="#FF6C63FF"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/btn_copy_code"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:padding="4dp"
                        android:contentDescription="Copy code"
                        android:src="@drawable/ic_new_chat"
                        app:tint="#FF9E9E9E"
                        android:background="@drawable/bg_icon_circle"
                        android:backgroundTint="#FF2A2A3E" />
                </LinearLayout>

                <!-- Code Content -->
                <TextView
                    android:id="@+id/tv_code_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:fontFamily="monospace"
                    android:textColor="#FFE0E0E0"
                    android:textSize="12sp"
                    android:lineSpacingExtra="2dp"
                    android:textIsSelectable="true" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- Action Row -->
    <LinearLayout android:id="@+id/action_row"
        android:layout_width="wrap_content" android:layout_height="32dp"
        android:gravity="center_vertical" android:orientation="horizontal"
        android:paddingTop="2dp" android:visibility="gone">

        <ImageView android:id="@+id/btn_copy" android:layout_width="28dp"
            android:layout_height="28dp" android:padding="4dp"
            android:contentDescription="Copy" android:src="@drawable/ic_new_chat"
            android:background="@drawable/bg_icon_circle" android:backgroundTint="#FF2A2A3E" />

        <ImageView android:id="@+id/btn_share" android:layout_width="28dp"
            android:layout_height="28dp" android:layout_marginStart="6dp" android:padding="4dp"
            android:contentDescription="Share" android:src="@drawable/ic_send"
            android:background="@drawable/bg_icon_circle" android:backgroundTint="#FF2A2A3E" />

        <ImageView android:id="@+id/btn_speak" android:layout_width="28dp"
            android:layout_height="28dp" android:layout_marginStart="6dp" android:padding="4dp"
            android:contentDescription="Speak" android:src="@drawable/ic_mic"
            android:background="@drawable/bg_icon_circle" android:backgroundTint="#FF2A2A3E" />
    </LinearLayout>
</LinearLayout>
