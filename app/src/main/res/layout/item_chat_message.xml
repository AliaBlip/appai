<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/message_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="3dp"
    android:paddingBottom="3dp"
    android:paddingLeft="4dp"
    android:paddingRight="4dp">

    <!-- Header -->
    <LinearLayout android:id="@+id/layout_header"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal"
        android:paddingBottom="3dp">

        <ImageView android:id="@+id/iv_avatar" android:layout_width="22dp"
            android:layout_height="22dp" android:contentDescription="Avatar" />

        <TextView android:id="@+id/tv_sender" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginStart="6dp"
            android:textSize="11sp" android:textStyle="bold" />

        <TextView android:id="@+id/tv_timestamp" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginStart="6dp"
            android:textSize="9sp" />
    </LinearLayout>

    <!-- Bubble -->
    <LinearLayout android:id="@+id/layout_bubble"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:gravity="start" android:orientation="vertical"
        android:padding="3dp">

        <TextView android:id="@+id/tv_message" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:lineSpacingExtra="3dp"
            android:textColor="#FFFFFF" android:textSize="15sp" />
    </LinearLayout>

    <!-- Action Row (Copy, Share, Speak) -->
    <LinearLayout android:id="@+id/action_row"
        android:layout_width="wrap_content" android:layout_height="32dp"
        android:gravity="center_vertical" android:orientation="horizontal"
        android:paddingTop="2dp" android:visibility="gone">

        <ImageView android:id="@+id/btn_copy" android:layout_width="28dp"
            android:layout_height="28dp" android:padding="4dp"
            android:contentDescription="Copy" android:src="@drawable/ic_new_chat"
            android:rotation="0" android:background="@drawable/bg_icon_circle"
            android:backgroundTint="#FF2A2A3E" />

        <ImageView android:id="@+id/btn_share" android:layout_width="28dp"
            android:layout_height="28dp" android:layout_marginStart="6dp" android:padding="4dp"
            android:contentDescription="Share" android:src="@drawable/ic_send"
            android:background="@drawable/bg_icon_circle" android:backgroundTint="#FF2A2A3E" />

        <ImageView android:id="@+id/btn_speak" android:layout_width="28dp"
            android:layout_height="28dp" android:layout_marginStart="6dp" android:padding="4dp"
            android:contentDescription="Speak" android:src="@drawable/ic_mic"
            android:background="@drawable/bg_icon_circle" android:backgroundTint="#FF2A2A3E" />
    </LinearLayout>
</LinearLayout>
